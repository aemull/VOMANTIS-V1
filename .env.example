# Atur variabel ini di environment proses Django.
DB_NAME=vomantis
DB_USER=vomantis
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Untuk produksi, atur DJANGO_DEBUG=0 dan DJANGO_SECRET_KEY ke nilai rahasia yang unik.
