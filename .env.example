# Salin ke .env di sebelah manage.py dan isi kredensial database Anda.
DB_NAME=vomantis
DB_USER=vomantis
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Buat DJANGO_SECRET_KEY unik dengan: python -c "import secrets; print(secrets.token_hex(32))"
# Untuk produksi, gunakan DJANGO_DEBUG=0 dan konfigurasi HTTPS pada readme.md.
