# Copy these values into your shell environment; Django does not auto-load .env.
DB_ENGINE=mariadb
DB_NAME=vomantis
DB_USER=vomantis
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production values are generated by scripts/setup-debian.sh.
# Optional admin seed (export in the shell; do not commit a real password):
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=your-unique-strong-password
